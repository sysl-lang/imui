// Immediate-mode widgets with an abstract Painter interface.
// The core and FrameBuffer need no allocator. Enable the optional PlutoVG
// backend for embedded antialiased vector/text rendering into caller-owned RAM.
package {
  name = "imui"
  version = "0.3.0"
  sysl = "0.6.0"
}
features { plutovg = [plutovg] }
dependencies {
  plutovg { git = "github.com/sysl-lang/plutovg", version = "0.2.6", optional = true }
}
